# Secrets for cache-proxy services (systemd EnvironmentFile format:
# NAME=value, one per line, no quotes). Readable only by root and the
# cacheproxy group. Kept out of config.toml on purpose.

# Password for the SMTP account in [email] (unblock-request emails).
# CACHE_PROXY_SMTP_PASSWORD=

# URLhaus Auth-Key (free from the abuse.ch authentication portal), used by
# the daily block-list refresh.
# CACHE_PROXY_URLHAUS_KEY=
