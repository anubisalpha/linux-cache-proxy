[Unit]
Description=Cache proxy web UI
After=network.target

[Service]
Type=simple
User=cacheproxy
Group=cacheproxy
WorkingDirectory=/opt/cache-proxy
Environment=CACHE_PROXY_DIR=/var/lib/cache-proxy/files
Environment=CACHE_PROXY_DB=/var/lib/cache-proxy/index.db
Environment=PATH=/opt/cache-proxy/venv-webui/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
# Web UI listens on 443 (configurable in config.toml) as the non-root
# cacheproxy user -- this grants just enough capability to bind it,
# instead of running the service as root or setcap'ing the venv binary.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/bin/bash /opt/cache-proxy/run_webui.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
