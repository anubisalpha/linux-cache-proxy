[Unit]
Description=Refresh the cache proxy content-filter block lists
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cacheproxy
Group=cacheproxy
WorkingDirectory=/opt/cache-proxy
Environment=PYTHONDONTWRITEBYTECODE=1
# Optional: CACHE_PROXY_URLHAUS_KEY (URLhaus Auth-Key) lives here.
EnvironmentFile=-/etc/cache-proxy/secrets.env
ExecStart=/opt/cache-proxy/venv-proxy/bin/python3 -m cache_proxy.filterlists update
