[Unit]
Description=Cache proxy block page (shown to users when a site is blocked)
After=network.target

[Service]
Type=simple
User=cacheproxy
Group=cacheproxy
WorkingDirectory=/opt/cache-proxy
Environment=CACHE_PROXY_DIR=/var/lib/cache-proxy/files
Environment=CACHE_PROXY_DB=/var/lib/cache-proxy/index.db
Environment=PATH=/opt/cache-proxy/venv-webui/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
# SMTP password for unblock-request email (optional file).
EnvironmentFile=-/etc/cache-proxy/secrets.env
# Listens on port 80 as the non-root cacheproxy user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/bin/bash /opt/cache-proxy/run_blockpage.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
